<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Opts this project into src/Directory.Build.targets' MCP tool registry generation, same as
         Hello (see issue #29). -->
    <McpToolName>pager</McpToolName>
  </PropertyGroup>

  <!-- The topic is the one thing the pager needs that is worth keeping out of a config file: anyone who
       knows it can read the notifications and post to it. Service delivers it from KeePass as NTFY_TOPIC
       (issue #50); run without Service it is just an environment variable you set yourself (docs/
       ARCHITECTURE.md, invariants 1 and 3). -->
  <ItemGroup>
    <McpSecret Include="NTFY_TOPIC" Entry="ntfy" Key="desk-pager" />
  </ItemGroup>

  <!-- Base only: a tool must run without Service, Desk or Secrets (docs/ARCHITECTURE.md invariant 1). -->
  <ItemGroup>
    <ProjectReference Include="..\Base\Base.csproj" />
  </ItemGroup>

</Project>
