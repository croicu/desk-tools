<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- WinExe (no console, no taskbar entry) when targeting win-x64, src/Directory.Build.props'
         own default RuntimeIdentifier now, so a bare `dotnet build`/`run` gets this too, not just an
         explicit -r win-x64. Plain Exe (normal console subsystem) for everything else, including
         linux-x64's ELF output, which has no subsystem header to set regardless but keeps the
         property semantically correct. See tasks/wingui-console-poc.md. -->
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64'">WinExe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' != 'win-x64'">Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Base\Base.csproj" />
  </ItemGroup>

  <!-- Platform-specific console handling (AllocConsole on Windows, no-op on Linux/Neutral):
       folders are opted OUT of the default glob, then opted back IN per-RID, one folder at a time.
       Neutral covers everything that isn't win-x64/linux-x64, genuinely RuntimeIdentifier unset
       only happens now if src/Directory.Build.props' own win-x64 default is somehow cleared (e.g.
       explicit `/p:RuntimeIdentifier=` with no value); the IDE's own design-time build for
       IntelliSense still picks up that same default too, same as any other build. -->
  <ItemGroup>
    <Compile Remove="Platform/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Compile Include="Platform/Windows/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Compile Include="Platform/Linux/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'win-x64' AND '$(RuntimeIdentifier)' != 'linux-x64'">
    <Compile Include="Platform/Neutral/**/*.cs" />
  </ItemGroup>

</Project>
