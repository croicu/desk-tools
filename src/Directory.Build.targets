<Project>

  <!-- Imported at the END of each src/ project (unlike Directory.Build.props, imported at the
       START, before a project's own PropertyGroup runs), so $(OutputType) below already has its
       final value (e.g. Service.csproj's own RuntimeIdentifier-conditioned WinExe/Exe) by the time
       this Condition evaluates; a Directory.Build.props-based version of this same condition would
       silently never match, since OutputType isn't set yet at that import point. Scoped to Exe/
       WinExe outputs, so Base.csproj itself (a Library) is excluded; only Hello.csproj/
       Service.csproj/Desk.csproj actually run these targets, and since they share one output
       folder (src/Directory.Build.props' BaseOutputPath), each ends up copying the same repo-root
       files into that same folder rather than colliding on a differently-sourced file.

       Deliberately imperative Copy tasks, not declarative "None Include CopyToOutputDirectory"
       items: an item like that, even declared here rather than directly in Base.csproj, still
       propagates through ProjectReference to whatever references the owning project, and
       Hello.Tests/Service.Tests/Desk.Tests all reference their own app's csproj (for
       InternalsVisibleTo access), so it leaked settings.json/settings.local.json into their own
       test bins too, corrupting test isolation the same way putting the items directly in
       Base.csproj corrupted every test project's isolation (see git history). A Copy task tied
       explicitly to $(OutDir)/$(PublishDir) only ever touches the owning project's own output,
       never a referencing project's, since there's no item for MSBuild's cross-project
       content-propagation machinery to discover. -->
  <Target Name="CopySettingsToOutput" AfterTargets="Build" Condition="'$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe'">
    <!-- The real, committed default config, always copied. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\settings.json" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <!-- Personal, gitignored dev override (see .gitignore), convenient to have alongside the app
         in a local `dotnet build` output so running straight from out/ picks it up. Never copied to
         $(PublishDir) (see CopySettingsToPublish below): installer/Setup.wixproj globs its entire
         publish output into the installer, so a developer's own local override must never end up
         there. Skipped entirely when absent, it's optional, a fresh checkout without one
         shouldn't fail the build. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\settings.local.json" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(MSBuildThisFileDirectory)..\settings.local.json')" />
  </Target>

  <Target Name="CopySettingsToPublish" AfterTargets="Publish" Condition="'$(OutputType)' == 'Exe' OR '$(OutputType)' == 'WinExe'">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\settings.json" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Build-time MCP tool registry (see issue #29): a project opts in by setting <McpToolName> in
       its own PropertyGroup (e.g. src/Hello/Hello.csproj sets <McpToolName>hello</McpToolName>),
       a property, not an item, so it doesn't propagate to a referencing test project's own build
       the way CopyToOutputDirectory items did to settings.json above; MSBuild properties are
       private to the project that sets them. One small JSON file per tool
       ($(OutDir)mcp-registry/<name>.json or $(PublishDir)mcp-registry/<name>.json, see the two
       targets below), not one combined file: avoids a real race between two projects both trying to
       write the same combined file during a parallel build, and needs no cross-project item
       aggregation.

       Each entry is a full .mcp.json-shaped server fragment (type/command/args/env, matching that
       file's own "hello" entry exactly), plus a "name" field .mcp.json itself doesn't need (there,
       the tool's name is the surrounding object's own key; this registry is one file per tool, so
       there's no such key to borrow one from). "command": "dotnet" (not a separate "type": "dotnet"
       field, since .mcp.json's own "type" already means transport, "stdio", so a same-named field
       with a different meaning would collide) is what a future non-.NET entry would instead set to
       something else (e.g. "python"), the same extensibility goal, without the collision. "args"
       holds $(TargetFileName) (e.g. "Hello.dll"), the bare built file name, resolvable relative to
       the registry file's own directory: the registry and the file it references always land in the
       same folder, whether that's the shared $(OutDir) (src/Directory.Build.props' BaseOutputPath)
       or $(PublishDir) (installer/Setup.wixproj now publishes Hello.csproj alongside
       Service.csproj into the same $(AppPublishDir) specifically so this holds there too, see that
       project's own PublishAppForSetup remarks). "env" is always {} for now, nothing needs a
       per-tool env var yet. Deliberately just the generation side for now: no consumer reads this
       yet. -->
  <Target Name="GenerateMcpRegistryEntry" AfterTargets="Build" Condition="'$(McpToolName)' != ''">
    <PropertyGroup>
      <McpRegistryDir>$(OutDir)mcp-registry\</McpRegistryDir>
    </PropertyGroup>
    <MakeDir Directories="$(McpRegistryDir)" />
    <WriteLinesToFile
        File="$(McpRegistryDir)$(McpToolName).json"
        Lines="{&quot;name&quot;: &quot;$(McpToolName)&quot;, &quot;type&quot;: &quot;stdio&quot;, &quot;command&quot;: &quot;dotnet&quot;, &quot;args&quot;: [&quot;$(TargetFileName)&quot;], &quot;env&quot;: {}}"
        Overwrite="true" />
  </Target>

  <Target Name="GenerateMcpRegistryEntryForPublish" AfterTargets="Publish" Condition="'$(McpToolName)' != ''">
    <PropertyGroup>
      <McpRegistryPublishDir>$(PublishDir)mcp-registry\</McpRegistryPublishDir>
    </PropertyGroup>
    <MakeDir Directories="$(McpRegistryPublishDir)" />
    <WriteLinesToFile
        File="$(McpRegistryPublishDir)$(McpToolName).json"
        Lines="{&quot;name&quot;: &quot;$(McpToolName)&quot;, &quot;type&quot;: &quot;stdio&quot;, &quot;command&quot;: &quot;dotnet&quot;, &quot;args&quot;: [&quot;$(TargetFileName)&quot;], &quot;env&quot;: {}}"
        Overwrite="true" />
  </Target>

</Project>
