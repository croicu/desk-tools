<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Base\Base.csproj" />
  </ItemGroup>

  <!-- Same per-RID Platform/ selection as src/Service/Service.csproj (see its own remarks): the
       folders are opted OUT of the default glob, then one is opted back IN per RID. Windows holds
       the real implementations; Linux and Neutral are placeholders that throw AppError until a
       real Linux implementation exists (issue #50's Linux follow-up). -->
  <ItemGroup>
    <Compile Remove="Platform/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Compile Include="Platform/Windows/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Compile Include="Platform/Linux/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'win-x64' AND '$(RuntimeIdentifier)' != 'linux-x64'">
    <Compile Include="Platform/Neutral/**/*.cs" />
  </ItemGroup>

</Project>
