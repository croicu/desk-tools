<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <!-- Matches the win-x64 publish RID below: otherwise WixToolset.Sdk defaults InstallerPlatform
         to x86, which sends ProgramFiles6432Folder (see Package.wxs) to the 32-bit Program Files
         despite the payload being genuinely 64-bit. -->
    <Platform>x64</Platform>
    <!-- Fresh GUID per instantiation: see tasks/repo_setup.md's token table. Never reuse the
         literal placeholder below: Windows Installer uses UpgradeCode to identify a product
         family for upgrade detection, so two different products sharing one would collide. -->
    <UpgradeCode>{20db6e52-e895-490b-8208-ef74d76e901d}</UpgradeCode>
    <AppPublishDir>$(MSBuildThisFileDirectory)obj\publish\</AppPublishDir>
    <!-- Exposes the properties above to Package.wxs as WiX preprocessor variables ($(var.Name)):
         WixToolset.Sdk doesn't forward arbitrary MSBuild properties into the compiler on its own.
         Configuration is NOT added here: WixToolset.Sdk already predefines $(var.Configuration)
         itself from the MSBuild property of the same name; redeclaring it hits WIX0288. Package.wxs
         uses that predefined variable to decide whether to bundle .pdb files (Debug: yes, for local
         debugging against the installed copy; Release: no, matching today's shipped artifact). -->
    <DefineConstants>UpgradeCode=$(UpgradeCode)</DefineConstants>
    <!-- TargetName defaults to the project's own file name (Setup): override so the shipped
         installer is named Service.msi. -->
    <TargetName>Service</TargetName>
    <!-- Repo-root release/<Configuration>/, no Platform segment. WixToolset.Sdk's own default
         would be bin\$(Platform)\$(Configuration)\ under this project's own directory. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\release\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="$(AppPublishDir)">
      <BindName>App</BindName>
    </BindPath>
  </ItemGroup>

  <!-- WixToolset.Sdk's ProjectReference Publish="true" doesn't reliably trigger a fresh publish in
       one pass (see https://github.com/orgs/wixtoolset/discussions/8156), so this explicitly shells
       out to `dotnet publish` before the WiX build binds Package.wxs's Files glob against
       $(AppPublishDir). Framework-dependent + win-x64 so Service.exe is a real native
       Windows apphost (see CLAUDE.md's cross-platform Architecture convention, which this project
       is the deliberate Windows-only exception to, by nature of what an MSI is). Bundles
       $(Configuration), not hardcoded to Release, so a plain `dotnet build installer/Setup.wixproj`
       (defaults to Debug, matching the inner dev loop) bundles a Debug payload into
       release\Debug\Service.msi, while CD's own `-c Release` invocation bundles a Release payload
       into release\Release\Service.msi, same as before. -->
  <Target Name="PublishAppForSetup" BeforeTargets="CoreCompile">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\src\Service\Service.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -o &quot;$(AppPublishDir)&quot;" />
  </Target>

</Project>
