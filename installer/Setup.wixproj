<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <!-- Matches the win-x64 publish RID below: otherwise WixToolset.Sdk defaults InstallerPlatform
         to x86, which sends ProgramFiles6432Folder (see Package.wxs) to the 32-bit Program Files
         despite the payload being genuinely 64-bit. -->
    <Platform>x64</Platform>
    <!-- Fresh GUID per instantiation: see tasks/repo_setup.md's token table. Never reuse the
         literal placeholder below: Windows Installer uses UpgradeCode to identify a product
         family for upgrade detection, so two different products sharing one would collide. -->
    <UpgradeCode>{20db6e52-e895-490b-8208-ef74d76e901d}</UpgradeCode>
    <!-- Package.wxs's own ProductCode is pinned to this fixed GUID instead of the WiX default
         (omitting it mints a fresh random ProductCode on every build). A real release process is
         supposed to mint a new ProductCode alongside a version bump, but this project's Version is
         hardcoded 1.0.0.0 in both configurations (no bump-on-release story exists yet), so an
         unpinned ProductCode meant every single `dotnet build installer/Setup.wixproj` produced a
         "different product, identical version" under the same UpgradeCode, and MajorUpgrade's
         default AllowSameVersionUpgrades="false" doesn't know how to reconcile that, so a reinstall
         attempt (via REINSTALL=ALL, or even a plain `msiexec /i` rerun without uninstalling the old
         ProductCode first) silently no-ops instead of replacing the old install. This stayed
         invisible for as long as every reinstall went through an uninstall first (removing the old
         ProductCode makes the new one's identity irrelevant), confirmed the hard way testing a
         forced-reinstall dev-loop shortcut (REINSTALL=ALL/REINSTALLMODE=amus), which specifically
         needs Windows Installer to recognize "the product I'm installing" and "the product already
         installed" as the same one. If a real version-bump-per-release story is ever added, revisit
         whether this should go back to being release-build-specific
         ($(var.Configuration)-conditioned) instead of unconditionally pinned. -->
    <ProductCode>{5cf17584-dad2-4667-a6a5-6020f6a95265}</ProductCode>
    <AppPublishDir>$(MSBuildThisFileDirectory)obj\publish\</AppPublishDir>
    <!-- Exposes the properties above to Package.wxs as WiX preprocessor variables ($(var.Name)):
         WixToolset.Sdk doesn't forward arbitrary MSBuild properties into the compiler on its own.
         Configuration is NOT added here: WixToolset.Sdk already predefines $(var.Configuration)
         itself from the MSBuild property of the same name; redeclaring it hits WIX0288. Package.wxs
         uses that predefined variable to decide whether to bundle .pdb files (Debug: yes, for local
         debugging against the installed copy; Release: no, matching today's shipped artifact). -->
    <DefineConstants>UpgradeCode=$(UpgradeCode);ProductCode=$(ProductCode)</DefineConstants>
    <!-- TargetName defaults to the project's own file name (Setup): override so the shipped
         installer is named Service.msi. -->
    <TargetName>Service</TargetName>
    <!-- Repo-root release/<Configuration>/, no Platform segment. WixToolset.Sdk's own default
         would be bin\$(Platform)\$(Configuration)\ under this project's own directory. -->
    <OutputPath>$(MSBuildThisFileDirectory)..\release\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="$(AppPublishDir)">
      <BindName>App</BindName>
    </BindPath>
  </ItemGroup>

  <!-- WixToolset.Sdk's ProjectReference Publish="true" doesn't reliably trigger a fresh publish in
       one pass (see https://github.com/orgs/wixtoolset/discussions/8156), so this explicitly shells
       out to `dotnet publish` before the WiX build binds Package.wxs's Files glob against
       $(AppPublishDir). Framework-dependent + win-x64 so Service.exe is a real native
       Windows apphost (see CLAUDE.md's cross-platform Architecture convention, which this project
       is the deliberate Windows-only exception to, by nature of what an MSI is). Bundles
       $(Configuration), not hardcoded to Release, so a plain `dotnet build installer/Setup.wixproj`
       (defaults to Debug, matching the inner dev loop) bundles a Debug payload into
       release\Debug\Service.msi, while CD's own `-c Release` invocation bundles a Release payload
       into release\Release\Service.msi, same as before.

       Also publishes Hello.csproj and Desk.csproj into the same $(AppPublishDir) (see issue #29):
       without Hello, src/Hello/Hello.csproj's own build-time-generated mcp-registry/hello.json
       would reference a Hello.dll that was never actually shipped in the MSI at all; none of
       Service.csproj/Hello.csproj/Desk.csproj reference each other, so publishing one alone never
       pulls the others in. All three publishing into the identical output folder is safe (matches
       how they already share one build-time output folder too, src/Directory.Build.props'
       BaseOutputPath): each references Base.csproj, so each publish independently produces its own
       copy of Base.dll/Base.pdb into that shared folder, and since all three are built from the
       exact same Configuration, each later publish's copy just harmlessly overwrites the earlier,
       identical one.

       Same reasoning applies to scripts/Scripts.csproj (see its own remarks): without this,
       goodbye.py/link-program-files.py/unlink-program-files.py and their mcp-registry/*.json
       entries would never reach $(AppPublishDir) at all, so a real MSI install would be missing
       the Python tools entirely despite `dotnet build` locally having them all along. No -r flag
       and no self-contained flag here, unlike the three above: Scripts.csproj is a
       Microsoft.Build.NoTargets project (no compiled output, just Copy/WriteLinesToFile targets
       keyed off $(PublishDir)), so those flags would be inert; confirmed `dotnet publish
       scripts/Scripts.csproj -o <dir>` alone already produces both the .py files and
       mcp-registry/*.json correctly. -->
  <Target Name="PublishAppForSetup" BeforeTargets="CoreCompile">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\src\Service\Service.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -o &quot;$(AppPublishDir)&quot;" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\src\Hello\Hello.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -o &quot;$(AppPublishDir)&quot;" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\src\Desk\Desk.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -o &quot;$(AppPublishDir)&quot;" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\scripts\Scripts.csproj&quot; -c $(Configuration) -o &quot;$(AppPublishDir)&quot;" />
  </Target>

</Project>
