<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Desk Tools"
           Manufacturer="Croicu"
           Version="1.0.0.0"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Desk Tools">
        <!-- No explicit Feature/ComponentRef: relies on WiX's default-feature auto-inclusion for
             naked Files, same pattern wixtoolset/wix's own HarvestFiles/Directory.wxs test uses,
             which is enough for a single-feature, files-only installer. -->
        <!-- .pdb files are excluded for Release (today's shipped artifact stays symbol-free) but
             kept for Debug, so a locally-built/installed MSI can still be debugged against. -->
        <?if $(var.Configuration) = "Release" ?>
        <Files Include="!(bindpath.App)\**">
          <Exclude Files="!(bindpath.App)\**\*.pdb" />
        </Files>
        <?else?>
        <Files Include="!(bindpath.App)\**" />
        <?endif?>
      </Directory>
    </StandardDirectory>

  </Package>
</Wix>
