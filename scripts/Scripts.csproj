<Project Sdk="Microsoft.Build.NoTargets/3.7.56">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Reuses src/Directory.Build.props' own BaseOutputPath/RuntimeIdentifier default rather than
       duplicating them, since scripts/ isn't a descendant of src/ or tests/, so MSBuild's own
       Directory.Build.props auto-import wouldn't find either of those files walking up from here,
       needing an explicit Import instead. Resolving to the identical shared out/<Configuration>/
       net10.0/[<RID>/] folder Service.csproj/Hello.csproj/Desk.csproj already build into is the
       whole point: a Python tool's own mcp-registry/<name>.json still lands right there, next to
       everything else's, so McpToolLauncher's existing "the registry lives in Service's own
       directory" lookup (see issue #29) continues to work unchanged. The scripts themselves land
       one level down, in a scripts\ subfolder of that same shared folder (see
       CopyPythonMcpTools/ToPublish below); args resolve relative to the registry's own directory
       too, so each entry's own args just spell out "scripts/<name>.py" instead of "<name>.py" to
       say so, no new path-resolution logic needed in McpToolLauncher either way. -->
  <Import Project="$(MSBuildThisFileDirectory)..\src\Directory.Build.props" />

  <!-- Each item is one Python MCP tool: "goodbye" implies both the script file (scripts/goodbye.py)
       and the registry entry's own name, mirroring <McpToolName>'s per-project opt-in for .NET
       tools (see src/Directory.Build.targets), just item-based instead of property-based, since
       this one NoTargets project covers every Python tool rather than one project per tool. -->
  <ItemGroup>
    <McpPythonTool Include="goodbye" />
    <McpPythonTool Include="link-program-files" />
    <McpPythonTool Include="unlink-program-files" />
  </ItemGroup>

  <Target Name="CopyPythonMcpTools" AfterTargets="Build" Inputs="$(MSBuildThisFileDirectory)%(McpPythonTool.Identity).py" Outputs="$(OutDir)scripts\%(McpPythonTool.Identity).py">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)%(McpPythonTool.Identity).py" DestinationFolder="$(OutDir)scripts\" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPythonMcpToolsToPublish" AfterTargets="Publish" Inputs="$(MSBuildThisFileDirectory)%(McpPythonTool.Identity).py" Outputs="$(PublishDir)scripts\%(McpPythonTool.Identity).py">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)%(McpPythonTool.Identity).py" DestinationFolder="$(PublishDir)scripts\" SkipUnchangedFiles="true" />
  </Target>

  <!-- Same registry fragment shape as src/Directory.Build.targets' own GenerateMcpRegistryEntry,
       "command": "python" instead of "dotnet" is the one difference (see that target's own remarks
       on why this, not a separate "type": "dotnet"-style field, is the extensibility point this
       registry was always meant to have). Batched via Inputs/Outputs over @(McpPythonTool) so this
       runs once per tool, one file each, same "avoid a race between tools writing one combined
       file" reasoning as the .NET-side targets. -->
  <!-- Secret declarations for Python tools (issue #50). Same <McpSecret> item as a .NET tool declares in its
       own project (see src/Directory.Build.targets' ComputeMcpSecretsFragment for the full explanation), but
       this one project covers every Python tool, so each item names its tool: <McpSecret Include="NTFY_TOPIC"
       Tool="pager" Entry="ntfy" Key="desk-pager" />. The generate targets below render the items whose Tool
       matches the tool being written into that tool's optional "secrets" array; a tool with none gets a
       fragment byte-identical to what it was before this existed.

       Validated at build time (the fragment is raw JSON text, and a developer's own typo is cheapest to catch
       here): Entry, Key and Tool must be non-empty, Tool must name an <McpPythonTool> that exists (a typo'd
       name would otherwise silently declare nothing), and no value may contain a double quote or a backslash.
       At run time the opposite rule holds - the manifest is optional and Service is a convenience, never a
       gate - see docs/ARCHITECTURE.md's invariants for MCP tools. -->
  <Target Name="ValidateMcpPythonSecrets">
    <PropertyGroup>
      <_McpPythonToolList>;@(McpPythonTool);</_McpPythonToolList>
    </PropertyGroup>
    <ItemGroup>
      <_McpSecretInvalid Include="@(McpSecret)" Condition="'%(McpSecret.Entry)' == '' Or '%(McpSecret.Key)' == '' Or '%(McpSecret.Tool)' == '' Or !$(_McpPythonToolList.Contains(';%(McpSecret.Tool);')) Or $([System.String]::new('%(McpSecret.Identity)%(McpSecret.Entry)%(McpSecret.Key)%(McpSecret.Tool)').Contains('&quot;')) Or $([System.String]::new('%(McpSecret.Identity)%(McpSecret.Entry)%(McpSecret.Key)%(McpSecret.Tool)').Contains('\'))" />
    </ItemGroup>
    <Error Condition="'@(_McpSecretInvalid)' != ''" Text="Invalid McpSecret item(s) in scripts/Scripts.csproj: @(_McpSecretInvalid). Each needs non-empty Entry, Key and Tool metadata, Tool must name an McpPythonTool, and no value may contain a double quote or a backslash." />
  </Target>

  <Target Name="GeneratePythonMcpRegistryEntries" AfterTargets="Build" DependsOnTargets="ValidateMcpPythonSecrets" Inputs="@(McpPythonTool)" Outputs="$(OutDir)mcp-registry\%(McpPythonTool.Identity).json">
    <MakeDir Directories="$(OutDir)mcp-registry\" />
    <PropertyGroup>
      <_McpToolBucket>%(McpPythonTool.Identity)</_McpToolBucket>
      <McpSecretsFragment></McpSecretsFragment>
      <McpSecretsFragment Condition="'@(McpSecret->WithMetadataValue('Tool', '$(_McpToolBucket)'))' != ''">, &quot;secrets&quot;: [@(McpSecret->WithMetadataValue('Tool', '$(_McpToolBucket)')->'{&quot;env&quot;: &quot;%(Identity)&quot;, &quot;entry&quot;: &quot;%(Entry)&quot;, &quot;key&quot;: &quot;%(Key)&quot;}', ', ')]</McpSecretsFragment>
    </PropertyGroup>
    <WriteLinesToFile
        File="$(OutDir)mcp-registry\%(McpPythonTool.Identity).json"
        Lines="{&quot;name&quot;: &quot;%(McpPythonTool.Identity)&quot;, &quot;type&quot;: &quot;stdio&quot;, &quot;command&quot;: &quot;python&quot;, &quot;args&quot;: [&quot;scripts/%(McpPythonTool.Identity).py&quot;], &quot;env&quot;: {}$(McpSecretsFragment)}"
        Overwrite="true" />
  </Target>

  <Target Name="GeneratePythonMcpRegistryEntriesForPublish" AfterTargets="Publish" DependsOnTargets="ValidateMcpPythonSecrets" Inputs="@(McpPythonTool)" Outputs="$(PublishDir)mcp-registry\%(McpPythonTool.Identity).json">
    <MakeDir Directories="$(PublishDir)mcp-registry\" />
    <PropertyGroup>
      <_McpToolBucket>%(McpPythonTool.Identity)</_McpToolBucket>
      <McpSecretsFragment></McpSecretsFragment>
      <McpSecretsFragment Condition="'@(McpSecret->WithMetadataValue('Tool', '$(_McpToolBucket)'))' != ''">, &quot;secrets&quot;: [@(McpSecret->WithMetadataValue('Tool', '$(_McpToolBucket)')->'{&quot;env&quot;: &quot;%(Identity)&quot;, &quot;entry&quot;: &quot;%(Entry)&quot;, &quot;key&quot;: &quot;%(Key)&quot;}', ', ')]</McpSecretsFragment>
    </PropertyGroup>
    <WriteLinesToFile
        File="$(PublishDir)mcp-registry\%(McpPythonTool.Identity).json"
        Lines="{&quot;name&quot;: &quot;%(McpPythonTool.Identity)&quot;, &quot;type&quot;: &quot;stdio&quot;, &quot;command&quot;: &quot;python&quot;, &quot;args&quot;: [&quot;scripts/%(McpPythonTool.Identity).py&quot;], &quot;env&quot;: {}$(McpSecretsFragment)}"
        Overwrite="true" />
  </Target>

</Project>
