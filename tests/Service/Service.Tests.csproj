<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Service\Service.csproj" />
    <ProjectReference Include="..\Mocks\Mocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="data\settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Mirrors src/Service/Service.csproj's own Platform/-selection exactly, so this test project's
       compiled-in SingletonGuardTests.cs/HandleDuplicatorTests.cs pair with whichever
       SingletonGuard/HandleDuplicator variant that ProjectReference itself actually compiled for
       the same RID: Unit/Platform/Windows/ tests the real Mutex-based guard/real DuplicateHandle
       (win-x64 is tests/Directory.Build.props' own default now, so a plain `dotnet test` already
       exercises these), Unit/Platform/Neutral/ tests the no-op/"not supported" stand-ins' own
       contract (only reachable now via an explicit override, e.g. `DESK_TOOLS_RID` cleared, see
       tests/Directory.Build.props' own remarks), and Unit/Platform/Linux/ likewise for
       `DESK_TOOLS_RID=linux-x64`. -->
  <ItemGroup>
    <Compile Remove="Unit/Platform/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Compile Include="Unit/Platform/Windows/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Compile Include="Unit/Platform/Linux/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'win-x64' AND '$(RuntimeIdentifier)' != 'linux-x64'">
    <Compile Include="Unit/Platform/Neutral/**/*.cs" />
  </ItemGroup>

</Project>
