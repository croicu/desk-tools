<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Secrets\Secrets.csproj" />
  </ItemGroup>

  <!-- The dummy test database (master password "password"), shared with tests/Secrets rather than
       copied: it lands next to the exe as data\Secrets.kdbx, the default database path. -->
  <ItemGroup>
    <None Include="..\..\Secrets\data\Secrets.kdbx" Link="data\Secrets.kdbx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
