<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Secrets\Secrets.csproj" />
  </ItemGroup>

  <!-- Mirrors src/Secrets/Secrets.csproj's own Platform/ selection exactly, so the compiled-in
       CliLocationTests pair with whichever CliLocation variant that ProjectReference compiled for
       the same RID (see tests/Service/Service.Tests.csproj for the same pattern). -->
  <ItemGroup>
    <Compile Remove="Unit/Platform/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <Compile Include="Unit/Platform/Windows/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Compile Include="Unit/Platform/Linux/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'win-x64' AND '$(RuntimeIdentifier)' != 'linux-x64'">
    <Compile Include="Unit/Platform/Neutral/**/*.cs" />
  </ItemGroup>

  <!-- Dummy KeePass database (master password "password", one entry "ntfy") for the Integration
       tests (never a real secret; see issue #50). Lives in tests/data, shared with the test apps; it
       lands next to the test assembly as data\Secrets.kdbx. -->
  <ItemGroup>
    <None Include="..\data\Secrets.kdbx" Link="data\Secrets.kdbx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
