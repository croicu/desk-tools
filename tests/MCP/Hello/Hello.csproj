<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- A test fixture, not a product (issue #86): the minimal hand-rolled stdio MCP server the integration tests launch
       to prove the registry, the launch path and the stdio handoff end to end. No McpToolName, so it gets no
       generated mcp-registry fragment, and the installer does not publish it; the tests that use it write a
       throwaway registry pointing at its built Hello.dll. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Base\Base.csproj" />
  </ItemGroup>

</Project>
