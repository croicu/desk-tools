{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "rebuild",
      "type": "shell",
      "command": "dotnet clean && dotnet build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "dotnet test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "format",
      "type": "shell",
      "command": "dotnet format",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "dotnet format --verify-no-changes",
      "problemMatcher": []
    },
    {
      "label": "publish",
      "type": "shell",
      "dependsOn": "rebuild",
      "command": "dotnet publish src/Service -c Release -o publish",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish (Debug)",
      "type": "shell",
      "dependsOn": "rebuild",
      "command": "dotnet publish src/Service -c Debug -o publish-debug",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-msi (Debug)",
      "type": "shell",
      "command": "dotnet build installer/Setup.wixproj",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "uninstall-msi (Debug)",
      "type": "shell",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "command": "if (Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*' -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -eq 'Desk Tools' }) { msiexec /x release\\Debug\\Service.msi }",
      "problemMatcher": []
    },
    {
      "label": "install-msi (Debug)",
      "type": "shell",
      "dependsOn": [
        "build-msi (Debug)",
        "uninstall-msi (Debug)"
      ],
      "dependsOrder": "sequence",
      "command": "msiexec",
      "args": [
        "/i",
        "release\\Debug\\Service.msi"
      ],
      "problemMatcher": []
    },
    {
      "label": "zap",
      "type": "shell",
      "problemMatcher": [],
      "windows": {
        "command": "Get-ChildItem -Recurse -Directory -Include bin,obj,publish,publish-debug | Remove-Item -Recurse -Force; if (Test-Path out) { Remove-Item -Recurse -Force out }"
      },
      "linux": {
        "command": "find . -type d \\( -name bin -o -name obj -o -name publish -o -name publish-debug \\) -prune -exec rm -rf {} +; rm -rf out"
      },
      "osx": {
        "command": "find . -type d \\( -name bin -o -name obj -o -name publish -o -name publish-debug \\) -prune -exec rm -rf {} +; rm -rf out"
      }
    }
  ]
}