{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "rebuild",
      "type": "shell",
      "command": "dotnet clean && dotnet build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "shell",
      "command": "dotnet test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "format",
      "type": "shell",
      "command": "dotnet format",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "dotnet format --verify-no-changes",
      "problemMatcher": []
    },
    {
      "label": "publish",
      "type": "shell",
      "dependsOn": "rebuild",
      "command": "dotnet publish src/Service -c Release -o publish",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish (Debug)",
      "type": "shell",
      "dependsOn": "rebuild",
      "command": "dotnet publish src/Service -c Debug -o publish-debug",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-msi (Debug)",
      "type": "shell",
      "command": "dotnet build installer/Setup.wixproj",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "uninstall-msi (Debug)",
      "type": "shell",
      "command": "msiexec",
      "args": [
        "/x",
        // By ProductCode GUID (matches Package.wxs's pinned ProductCode), not by file path.
        // msiexec /x <path-to-msi> compares that file's PackageCode -- which regenerates on every
        // build, correctly, that's not a bug -- against what's actually cached from the original
        // install, and fails with error 1638 ("Another version of this product is already
        // installed") the moment they differ, even though ProductCode/Version still match.
        // Targeting the GUID directly makes Windows Installer resolve its own cached copy instead,
        // exactly like Add/Remove Programs' own uninstall entry does (see its UninstallString).
        "{5cf17584-dad2-4667-a6a5-6020f6a95265}"
      ],
      "problemMatcher": []
    },
    {
      "label": "install-msi (Debug)",
      "type": "shell",
      "dependsOn": [
        "build-msi (Debug)"
      ],
      "dependsOrder": "sequence",
      "command": "msiexec",
      "args": [
        "/i",
        "release\\Debug\\Service.msi"
      ],
      "problemMatcher": []
    },
    {
      "label": "zap",
      "type": "shell",
      "problemMatcher": [],
      "windows": {
        "command": "Get-ChildItem -Recurse -Directory -Include bin,obj,publish,publish-debug | Remove-Item -Recurse -Force; if (Test-Path out) { Remove-Item -Recurse -Force out }"
      },
      "linux": {
        "command": "find . -type d \\( -name bin -o -name obj -o -name publish -o -name publish-debug \\) -prune -exec rm -rf {} +; rm -rf out"
      },
      "osx": {
        "command": "find . -type d \\( -name bin -o -name obj -o -name publish -o -name publish-debug \\) -prune -exec rm -rf {} +; rm -rf out"
      }
    }
  ]
}